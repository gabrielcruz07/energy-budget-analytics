# Conexão com o banco de dados PostgreSQL (driver psycopg v3)
# Local: postgresql+psycopg://usuario:senha@localhost:5432/energy_budget
# Nuvem (Neon): postgresql+psycopg://usuario:senha@ep-seu-endpoint.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/energy_budget

# URL base da API FastAPI consumida pelo dashboard Streamlit
# Local: http://localhost:8000
# Produção (Render): https://sua-api.onrender.com
API_URL=http://localhost:8000